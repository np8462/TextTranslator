{
  "manifest_version": 3,
  "name": "TextTranslator",
  "version": "0.2.0",
  "description": "Select an English word on a webpage to see a Persian demo meaning.",
  "permissions": ["storage"],
  "action": {
    "default_title": "TextTranslator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
