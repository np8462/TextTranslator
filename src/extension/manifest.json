{
  "manifest_version": 3,
  "name": "TextTranslator – Online & Offline Dictionary",
  "version": "0.7.5",
  "description": "Translate selected or hovered words with pair-specific offline dictionaries and optional online lookup.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TextTranslator",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{
    "resources": ["dictionaries/*.json"],
    "matches": ["<all_urls>"]
  }],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://raw.githubusercontent.com/*"
  ]
}